{
  "name": "@temple-of-epiphany/imap-mcp-pro",
  "version": "2.17.1",
  "description": "Enterprise-grade IMAP MCP server with Level 1-3 reliability features, circuit breaker, metrics, and bulk operations for commercial and large-scale deployments",
  "main": "dist/index.js",
  "bin": {
    "imap-mcp": "./dist/index.js",
    "imap-setup": "./dist/setup.js"
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "setup": "tsx src/setup.ts",
    "web": "tsx src/web/server.ts",
    "migrate": "tsx src/cli/migrate.ts up",
    "migrate:status": "tsx src/cli/migrate.ts status",
    "migrate:dry-run": "tsx src/cli/migrate.ts dry-run",
    "migrate:rollback": "tsx src/cli/migrate.ts down",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "imap",
    "email",
    "claude",
    "ai",
    "model-context-protocol",
    "enterprise",
    "circuit-breaker",
    "reliability",
    "bulk-operations",
    "monitoring",
    "metrics",
    "production"
  ],
  "author": "Temple of Epiphany / Colin Bitterfield (colin.bitterfield@templeofepiphany.com)",
  "contributors": [
    {
      "name": "Michael Nikolaus",
      "url": "https://github.com/nikolausm"
    },
    {
      "name": "Colin Bitterfield",
      "email": "colin.bitterfield@templeofepiphany.com",
      "url": "https://github.com/cbitterfield"
    }
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Temple-of-Epiphany/imap-mcp-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Temple-of-Epiphany/imap-mcp-pro/issues"
  },
  "homepage": "https://github.com/Temple-of-Epiphany/imap-mcp-pro#readme",
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.14",
    "electron": "^41.3.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@journeyapps/sqlcipher": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@types/nodemailer": "^6.4.17",
    "body-parser": "^2.2.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-slow-down": "^3.0.1",
    "imapflow": "^1.1.1",
    "js-yaml": "^4.1.1",
    "keytar": "^7.9.0",
    "mailparser": "^3.7.4",
    "mime-types": "^3.0.2",
    "nodemailer": "^7.0.5",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
